import avro from "avsc";
import { parse as parseUuid, stringify as stringifyUuid } from "uuid";
import { Buffer } from "buffer";

const ONE_DAY_IN_MILLIS = 1000 * 60 * 60 * 24;

export class DateType extends avro.types.LogicalType {
    _fromValue(val) {
        return new Date(val * ONE_DAY_IN_MILLIS);
    }
    _toValue(date) {
        return Math.floor(date.valueOf() / ONE_DAY_IN_MILLIS);
    }
    _resolve(type) {
        if (avro.Type.isType(type, "int", "logical:days")) {
            return this._fromValue;
        } else {
            return undefined;
        }
    }
}

export class TimestampMillisType extends avro.types.LogicalType {
    _fromValue(val) {
        return new Date(val);
    }
    _toValue(date) {
        return date.valueOf();
    }
    _resolve(type) {
        if (avro.Type.isType(type, "int", "long", "string", "logical:timestamp-millis")) {
            return this._fromValue;
        } else {
            return undefined;
        }
    }
}

export class DurationType extends avro.types.LogicalType {
    _fromValue(val) {
        const months = val.readUInt32LE(0);
        const days = val.readUInt32LE(4);
        const millis = val.readUInt32LE(8);

        return { months: months, days: days, millis: millis };
    }

    _toValue(val) {
        let buf = new ArrayBuffer(12);
        let dataView = new DataView(buf);
        dataView.setUint32(0, val.months, true);
        dataView.setUint32(4, val.days, true);
        dataView.setUint32(8, val.millis, true);
        return Buffer.from(buf);
    }

    _resolve(type) {
        if (avro.type.isType(type, "logical:duration")) {
            return this._fromValue;
        } else {
            return undefined;
        }
    }
}

export class UuidType extends avro.types.LogicalType {
    _fromValue(val) {
        if (this.underlyingType == "string") {
            return val;
        } else {
            return stringifyUuid(val);
        }
    }

    _toValue(val) {
        if (this.underlyingType == "string") {
            return val;
        } else {
            const arr = parseUuid(val);
            return Buffer.from(arr.buffer);
        }
    }

    _resolve(type) {
        if (avro.type.isType(type, "logical:uuid")) {
            return this._fromValue;
        } else {
            return undefined;
        }
    }
}

export const _logicalTypes = {
    "date": DateType,
    "timestamp-millis": TimestampMillisType,
    "duration": DurationType,
    "uuid": UuidType,
}


