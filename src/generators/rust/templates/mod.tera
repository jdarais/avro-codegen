{% for mod in params.submodules -%}
pub mod {{ mod }};
{% endfor -%}


{% macro render_union_variant(schema) -%}
{% if schema.type == "null" -%}
    {# #}   Null,
{% elif schema.type == "boolean" -%}
    {# #}   Boolean(bool),
{% elif schema.type == "int" -%}
    {# #}   Int(i32),
{% elif schema.type == "long" -%}
    {# #}   Long(i64),
{% elif schema.type == "float" -%}
    {# #}   Float(f32),
{% elif schema.type == "double" -%}
    {# #}   Double(f64),
{% elif schema.type == "ref" -%}
    {# #}   {{ schema.namespace | title_case }}{{ schema.name }}()
{% endif -%}
{% endmacro render_union_variant -%}

{% for name, union in params.unions -%}
pub enum {{ name }} {
{% for variant in union.schema.variants -%}
{{ self::render_union_variant(schema=variant) -}}
{% endfor -%}
}
{% endfor -%}

{% macro render_record_field(name, schema) -%}
{% if schema.type == "null" -%}
    {# #}   pub {{ name }}: (),
{% elif schema.type == "boolean" -%}
    {# #}   pub {{ name }}: bool,
{% elif schema.type == "int" -%}
    {# #}    pub {{ name }}: i32,
{% elif schema.type == "long" -%}
    {# #}    pub {{ name }}: i64,
{% elif schema.type == "float" -%}
    {# #}    pub {{ name }}: f32,
{% elif schema.type == "double" -%}
    {# #}    pub {{ name }}: f64,
{% elif schema.type == "ref" -%}
    {# #}    // pub {{ name }}: {{ schema.fullname }}
{% else -%}
    {# #}    // {{ name }} is a {{ schema.type }}
{% endif -%}
{% endmacro render_record_field -%}



{% for schema in params.schemas -%}
{% if schema.type == "record" -%}
pub struct {{ schema.name }} {
{% for field in schema.fields -%}
{{ self::render_record_field(name=field.name, schema=field.type) -}}
{% endfor -%}
}
{% endif -%}
{% endfor -%}


