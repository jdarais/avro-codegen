{% import "types.tera" as types -%}

{% if params.schemas | length > 0 -%}
use std::io::{Read, Write};

use apache_avro::{AvroResult, schema::Schema};
use lazy_static::lazy_static;
use serde_json::json;
{% endif -%}

{% for mod in params.submodules -%}
pub mod {{ mod }};
{% endfor -%}

{% macro render_record_field(name, schema) -%}
    {# #}   pub {{ name }}: {{ types::render_type(schema=schema) }},
{% endmacro render_record_field -%}


{% for schema in params.schemas -%}
{% if schema.type == "record" -%}
#[derive(serde::Serialize, serde::Deserialize, Debug, PartialEq)]
pub struct {{ schema.name }} {
{% for field in schema.fields -%}
    {{ self::render_record_field(name=field.name, schema=field.type) -}}
{% endfor -%}
}
{% elif schema.type == "fixed" -%}
#[derive(serde::Serialize, serde::Deserialize, Debug, PartialEq)]
pub struct {{ schema.name }}(pub [u8;{{schema.size}}]);
{% elif schema.type == "enum" -%}
#[derive(serde::Serialize, serde::Deserialize, Debug, PartialEq)]
pub enum {{ schema.name }} {
{% for symbol in schema.symbols -%}
{# #}    #[serde(rename="{{ symbol }}")]
{# #}    {{ symbol | title_case }},
{% endfor -%}
}
{% endif -%}

lazy_static! {
    pub static ref {{ schema.name | const_case }}_SCHEMA: Schema = Schema::parse(&json!({{ schema.json }})).unwrap();
}

impl {{ schema.name | title_case }} {
    pub fn schema() -> &'static Schema { &{{ schema.name | const_case }}_SCHEMA }

    pub fn reader<R: Read>(input: R) -> AvroResult<apache_avro::Reader<'static, R>> {
        apache_avro::Reader::with_schema(&{{ schema.name | const_case }}_SCHEMA, input)
    }

    pub fn read_next<'a, R: Read>(reader: &mut apache_avro::Reader<'a, R>) -> Option<AvroResult<{{ schema.name | title_case }}>> {
        match reader.next() {
            None => None,
            Some(val_res) => {
                Some(val_res.and_then(|val| apache_avro::from_value(&val)))
            }
        }
    }

    pub fn read_single<'a, R: Read>(input: R) -> Option<AvroResult<{{ schema.name | title_case }}>> {
        let mut reader = match {{ schema.name | title_case }}::reader(input) {
            Ok(r) => r,
            Err(e) => { return Some(Err(e)); }
        };
        {{ schema.name | title_case }}::read_next(&mut reader)
    }

    pub fn writer<W: Write>(output: W) -> apache_avro::Writer<'static, W> {
        apache_avro::Writer::new(&{{ schema.name | const_case }}_SCHEMA, output)
    }

    pub fn write<'a, W: Write>(&self, writer: &mut apache_avro::Writer<'a, W>) -> AvroResult<usize> {
        writer.append_ser(self)
    }

    pub fn write_single<'a, W: Write>(&self, output: W) -> AvroResult<usize> {
        let mut bytes_written: usize = 0;

        let mut writer = {{ schema.name | title_case }}::writer(output);
        bytes_written += self.write(&mut writer)?;
        bytes_written += writer.flush()?;
        Ok(bytes_written)
    }
}

{% endfor -%}


