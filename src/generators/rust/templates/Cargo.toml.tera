[package]
name = "{{ package.name | kebab_case }}"
version = "{{ package.version }}"
description = "{{ package.description }}"
edition = "2021"
rust-version = "1.81"

[dependencies]
apache-avro = "0.22.0"
bigdecimal = "0.4.9"
lazy_static = "1.5.0"
serde = "1.0.228"
serde_bytes = "0.11.19"
serde_json = "1.0.150"
uuid = { default-features = false, version = "1.19.0", features = ["serde", "std"] }
